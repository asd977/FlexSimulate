  <property name="styleSheet">
   <string notr="true">QWidget#centralwidget {
    background-color: #f8fafc;
}

QFrame#navigationFrame,
QWidget#detailPanel,
QFrame#vtkContainer,
QFrame#logPanel {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

QFrame#navigationFrame {
    padding: 16px;
}

QWidget#detailPanel {
    padding: 16px;
}

QFrame#vtkContainer,
QFrame#logPanel {
    padding: 16px;
}

QLabel#navigationTitle,
QLabel#detailTitle,
QLabel#vtkTitle,
QLabel#logTitle {
    font-size: 18px;
    font-weight: 600;
    color: #0f172a;
    padding-bottom: 8px;
}

QTreeWidget,
QPlainTextEdit,
QLineEdit {
    font-size: 14px;
}

QTreeWidget {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background-color: #ffffff;
}

QLineEdit {
    border: 1px solid #cbd5f5;
    border-radius: 8px;
    padding: 6px 10px;
    background-color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #2563eb;
}

QPlainTextEdit {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px;
    background-color: #f8fafc;
}

QPushButton {
    font-size: 14px;
    color: #ffffff;
    background-color: #2563eb;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
}

QPushButton:hover {
    background-color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #1e3a8a;
}

QSplitter::handle {
    background-color: #e2e8f0;
}

QSplitter::handle:horizontal {
    margin: 0 8px;
    width: 2px;
}

QSplitter::handle:vertical {
    margin: 8px 0;
    height: 2px;
}

QScrollArea {
    border: none;
    background: transparent;
}
</string>
